# Production values. Copy to ../.env (Smart-Surveillance-System/.env) and fill in.
DOMAIN=intellisafe.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=intellisafe
POSTGRES_PASSWORD=change-me
POSTGRES_DB=intellisafe

MQTT_USERNAME=intellisafe
MQTT_PASSWORD=change-me

# Dashboard login (Caddy basic auth). The hash is written by infra/scripts/gen-secrets.sh
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=change-me
BASIC_AUTH_HASH=

LOG_LEVEL=info
ENABLE_SIMULATE=true
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=3

# Shared secret the Jetson sends (x-api-key) when uploading alert frames. Generate: openssl rand -hex 24
EVIDENCE_UPLOAD_TOKEN=change-me
