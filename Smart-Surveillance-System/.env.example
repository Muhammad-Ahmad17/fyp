# Copy to .env and adjust as needed. Never commit .env.

# MQTT (Mosquitto)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=ppe
MQTT_CLIENT_ID_BRIDGE=mqtt-redis-bridge
MQTT_CLIENT_ID_SIMULATOR=event-simulator

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM_ALERTS=ppe:alerts
REDIS_STREAM_METRICS=ppe:metrics
REDIS_STREAM_HEARTBEAT=ppe:heartbeat
REDIS_DEAD_LETTER=ppe:dead_letter

# Simulator
SIMULATOR_INTERVAL_SEC=2.0
SIMULATOR_ENABLED=true

# Health stub (Month 2 warm-start)
HEALTH_STUB_PORT=8000
