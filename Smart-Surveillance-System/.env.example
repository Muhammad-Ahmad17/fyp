# Copy to .env (docker compose reads it from the project directory). Never commit .env.
# Every value has a working default; override only what you need.

# PostgreSQL
POSTGRES_USER=intellisafe
POSTGRES_PASSWORD=intellisafe
POSTGRES_DB=intellisafe

# MQTT auth (empty = anonymous, dev only; production sets these)
MQTT_USERNAME=
MQTT_PASSWORD=

# Simulator (mock Jetson)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SEC=2
SIMULATOR_DEVICE_ID=jetson-sim-01

# API
ENABLE_SIMULATE=true        # POST /api/simulate (dashboard "Mock event" button)
# Shared secret for the edge device's frame uploads (empty = open, dev only)
EVIDENCE_UPLOAD_TOKEN=
CORS_ORIGIN=                # empty = same-origin only
LOG_LEVEL=info
