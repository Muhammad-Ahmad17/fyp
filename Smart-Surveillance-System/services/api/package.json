{
  "name": "@intellisafe/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Alert consumer + REST + WebSocket gateway",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "mqtt": "^5.16.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7",
    "@intellisafe/contracts": "*",
    "@intellisafe/simulator": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.12",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "aedes": "^1.2.0",
    "drizzle-kit": "^0.31.11",
    "ioredis-mock": "^8.13.1",
    "supertest": "^7.3.1",
    "@intellisafe/bridge": "*"
  }
}
